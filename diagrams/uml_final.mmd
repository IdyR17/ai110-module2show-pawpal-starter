classDiagram
    %% Final design, matching pawpal_system.py. See uml_initial.mmd for the original design.

    class Owner {
        +str name
        +int available_minutes
        +time day_start
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_pets() list~Pet~
        +get_all_tasks() list~tuple~
        +set_available_time(minutes: int) None
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task: Task) None
        +get_tasks() list~Task~
        +complete_task(task: Task, today: date) Task
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str frequency
        +bool completed
        +str time
        +date due_date
        +edit(duration_minutes: int, priority: str) None
        +mark_complete(today: date) Task
        +is_due(today: date) bool
        +is_high_priority() bool
        +priority_rank() int
    }

    class ScheduledTask {
        +Pet pet
        +Task task
        +time start_time
        +str reason
    }

    class Scheduler {
        +Owner owner
        +date today
        +list~ScheduledTask~ plan
        +list~ScheduledTask~ skipped
        +sort_by_time(items) list~tuple~
        +filter_tasks(pet_name: str, completed: bool) list~tuple~
        +generate_plan() list~ScheduledTask~
        +detect_conflicts() list~str~
        +explain_plan() str
        +display_plan() str
        -_first_free_slot(duration_minutes: int) time
        -_at(t: time) datetime
    }

    note for Owner "get_all_tasks() returns (Pet, Task) pairs.\npreferences is stored but not used yet."
    note for Task "time is a fixed 'HH:MM' start, or None if flexible.\nfrequency is 'once', 'daily', or 'weekly'."

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : owns
    Pet ..> Task : complete_task() calls mark_complete()
    Task ..> Task : mark_complete() creates next occurrence
    Scheduler --> Owner : reads get_all_tasks()
    Scheduler "1" --> "0..*" ScheduledTask : creates
    ScheduledTask --> Pet : for
    ScheduledTask --> Task : wraps
