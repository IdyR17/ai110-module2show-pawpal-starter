classDiagram
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +int available_minutes
        +time day_start
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_pets() list~Pet~
        +get_all_tasks() list~tuple~
        +set_available_time(minutes: int) None
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task: Task) None
        +get_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str frequency
        +bool completed
        +edit(duration_minutes: int, priority: str) None
        +mark_complete() None
        +is_high_priority() bool
        +priority_rank() int
    }

    class ScheduledTask {
        +Pet pet
        +Task task
        +time start_time
        +str reason
    }

    class Scheduler {
        +Owner owner
        +list~ScheduledTask~ plan
        +list~ScheduledTask~ skipped
        +generate_plan() list~ScheduledTask~
        +explain_plan() str
        +display_plan() str
    }

    Owner "1" --> "1..*" Pet : has
    Pet "1" --> "0..*" Task : has
    Scheduler --> Owner : plans for
    Scheduler "1" --> "0..*" ScheduledTask : creates
    ScheduledTask --> Pet : for
    ScheduledTask --> Task : wraps
